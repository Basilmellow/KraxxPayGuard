# Node 24.18+. npm run setup generates distinct random local access tokens.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=data/payguard.sqlite
# Both required, distinct, at least 32 characters. Never expose either in URLs.
SHOPPER_TOKEN=
OPERATOR_TOKEN=
# Use the Sandbox business app and its merchant ID, never live credentials.
# The API hostname is fixed in code and cannot be configured to a live endpoint.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
# Sponsor gateway is the default. Existing OpenAI keys are ignored unless explicitly selected.
MODEL_PROVIDER=astropods
ASTRO_GATEWAY_URL=
ASTRO_GATEWAY_API_KEY=
MODEL_DEFAULT=claude-haiku-4-5
# Optional legacy provider, only used with MODEL_PROVIDER=openai. May incur costs.
OPENAI_API_KEY=
# Select a model available to your account supporting Responses function tools.
OPENAI_MODEL=
