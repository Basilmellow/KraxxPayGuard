# Node 24.18+. npm run setup generates distinct random local access tokens.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=data/payguard.sqlite
# Both required, distinct, at least 32 characters. Never expose either in URLs.
SHOPPER_TOKEN=
OPERATOR_TOKEN=
# Use the Sandbox business app and its merchant ID, never live credentials.
# The API hostname is fixed in code and cannot be configured to a live endpoint.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
# Explicit real-model mode requires BOTH values. No silent fixture fallback.
OPENAI_API_KEY=
# Select a model available to your account supporting Responses function tools.
OPENAI_MODEL=
